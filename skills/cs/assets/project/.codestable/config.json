{
  "schema_version": 3,
  "mode": "knowledge_wiki",
  "version": "1.2.0",
  "wiki": {
    "root": ".codestable/wiki",
    "current_entry": ".codestable/wiki/INDEX.md",
    "history_entry": ".codestable/wiki/HISTORY.md",
    "topics_entry": ".codestable/wiki/TOPICS.md",
    "categories": [
      "requirements",
      "architecture",
      "interfaces",
      "data-model",
      "error-handling",
      "transaction-boundaries",
      "compatibility",
      "performance-risks",
      "security-boundaries",
      "acceptance",
      "decisions"
    ],
    "legacy_read_roots": [
      ".codestable/model",
      ".codestable/knowledge"
    ],
    "repositories": {},
    "topics": {},
    "topic_history": [],
    "topic_governance": {
      "mode": "disabled",
      "minimum_coverage": 0.8,
      "review_max_age_days": 180
    },
    "max_scan_files": 2000
  },
  "brief": {
    "max_items": 18,
    "max_items_per_category": 3,
    "max_summaries": 3,
    "max_related_tasks": 3,
    "max_excerpt_chars": 700,
    "include_recent_decisions": 2,
    "include_superseded": false
  },
  "capture": {
    "always_write_task_note": true,
    "require_evidence_for_verified": true,
    "strict_durable_cards": true,
    "deduplicate": true,
    "secret_scan": true
  }
}
